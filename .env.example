# Cham.ai — Environment Configuration
# Copy this to .env and fill in real values.

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ── Ports ────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENCLAW_PORT=8765
QDRANT_PORT=6333
CLAWDTALK_PORT=9000

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com

# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=chamai
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
POSTGRES_DB=cham_ai

# ── Auth ─────────────────────────────────────────────────────────
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_SECRET=your-jwt-secret
ADMIN_EMAILS=hector.eng@gmail.com

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
AI_MODEL=gpt-4o

# ── OpenClaw (Agent Runtime) ─────────────────────────────────────
# Uncomment to route AI through OpenClaw instead of direct OpenAI
# AGENT_RUNTIME_URL=http://openclaw:8765/v1
# OPENCLAW_MODEL=nadirclaw
# OPENCLAW_TTS_MODEL=tts-1
# TTS_VOICE=alloy

# ── ClawdTalk (Telephony) ────────────────────────────────────────
CLAWDTALK_API_URL=http://clawdtalk:9000
CLAWDTALK_API_KEY=your-clawdtalk-api-key
# CLAWDTALK_SIP_SERVER=sip:your-pbx.example.com
# CLAWDTALK_SIP_USERNAME=your-sip-username
# CLAWDTALK_SIP_PASSWORD=your-sip-password

# ── Supabase Storage ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── UI Executor (AutoGLM / Playwright) ───────────────────────────
# UI_EXECUTOR_URL=http://localhost:9010
